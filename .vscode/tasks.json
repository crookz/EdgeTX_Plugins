{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy widget to radio",
      "detail": "Copies the widget of the open file to the radio SD card",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\deploy.ps1",
        "${file}"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": []
    }
  ]
}
